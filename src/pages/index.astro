---
import Layout from '../layouts/Layout.astro';
import SearchApp from '../components/SearchApp.jsx';
import { HOME_URL } from '../utils/assets.js';
import data from '../../public/data.json';

const { animes = [], generatedAt = new Date().toISOString() } = data || {};
const initialAnimes = animes.slice(0, 20);
---

<Layout
  title="Siwö — Archivo de Openings y Endings de Anime"
  description="Explora más de 600 openings y endings de anime: busca por título, filtra por temporada y año y abre la ficha de cada serie."
  generatedAt={generatedAt}
>
  <SearchApp
    initialAnimes={initialAnimes}
    animeCount={animes.length}
    dataUrl={`${HOME_URL}data.json`}
    generatedAt={generatedAt}
    client:load
  />
</Layout>
