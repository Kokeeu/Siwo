---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL || '/';
const homeUrl = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<Layout title="Acerca de Siwö" description="Siwö es un buscador de openings y endings de anime. Datos de AniTousen, imágenes y detalles por Jikan y AniList.">
  <div className="relative min-h-screen overflow-hidden font-inter">
    <div className="pointer-events-none fixed inset-0 z-0">
      <div className="absolute -left-[20%] top-[5%] h-[500px] w-[500px] rounded-full bg-[#14b8a6]/8 blur-[120px]" />
      <div className="absolute -right-[10%] top-[30%] h-[400px] w-[400px] rounded-full bg-[#38bdf8]/8 blur-[120px]" />
      <div className="absolute bottom-[5%] left-[30%] h-[450px] w-[450px] rounded-full bg-[#f59e0b]/8 blur-[140px]" />
    </div>

    <nav className="fixed top-0 left-0 right-0 z-50 border-b border-white/60 bg-white/80 shadow-[rgba(0,0,0,0.04)_0px_1px_2px_0px] backdrop-blur-xl">
      <div className="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
        <a href={homeUrl} className="flex items-center gap-3">
          <img src="avatar.jpg" alt="Siwö" class="h-8 w-8 rounded-full border border-[#e2e8f0] object-cover" />
          <span className="font-space text-[18px] font-bold tracking-[0.02em] text-[#1d242f]">Siwö</span>
        </a>
        <a href={homeUrl} className="text-[14px] font-medium text-[#6b7280] transition hover:text-[#14b8a6]">
          Volver al inicio
        </a>
      </div>
    </nav>

    <main className="relative z-10 mx-auto max-w-[720px] px-6 pb-24 pt-28">
      <article className="rounded-[24px] border border-white/60 bg-white/80 p-8 shadow-[rgba(0,0,0,0.06)_0px_8px_24px_-4px] backdrop-blur-2xl md:p-12">
        <h1 className="mb-6 font-space text-[32px] font-black text-[#1d242f] md:text-[42px]">
          Acerca de Siwö
        </h1>

        <p className="mb-6 text-[16px] leading-[1.7] text-[#374151]">
          Siwö es un buscador de openings y endings de anime. Recopilamos enlaces de descarga de{' '}
          <a
            href="https://anitousen.com/"
            target="_blank"
            rel="noopener noreferrer"
            className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
          >
            AniTousen
          </a>{' '}
          y los presentamos en una interfaz limpia, rápida y con metadatos enriquecidos para que encuentres tu música de anime favorita.
        </p>

        <h2 className="mb-3 mt-10 font-space text-[18px] font-bold text-[#1d242f]">
          Créditos
        </h2>
        <ul className="mb-6 space-y-2 text-[16px] leading-[1.7] text-[#374151]">
          <li>
            <strong className="text-[#1d242f]">Enlaces:</strong>{' '}
            <a
              href="https://anitousen.com/"
              target="_blank"
              rel="noopener noreferrer"
              className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
            >
              AniTousen
            </a>
          </li>
          <li>
            <strong className="text-[#1d242f]">Imágenes y detalles:</strong>{' '}
            <a
              href="https://jikan.moe/"
              target="_blank"
              rel="noopener noreferrer"
              className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
            >
              Jikan
            </a>{' '}
            y{' '}
            <a
              href="https://anilist.co/"
              target="_blank"
              rel="noopener noreferrer"
              className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
            >
              AniList
            </a>
          </li>
          <li>
            <strong className="text-[#1d242f]">Código fuente:</strong>{' '}
            <a
              href="https://github.com/Kokeeu/anitousen-search"
              target="_blank"
              rel="noopener noreferrer"
              className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
            >
              GitHub
            </a>
          </li>
        </ul>

        <h2 className="mb-3 mt-10 font-space text-[18px] font-bold text-[#1d242f]">
          Sígueme
        </h2>
        <p className="mb-6 text-[16px] leading-[1.7] text-[#374151]">
          Si te gusta el proyecto, sígueme en{' '}
          <a
            href="https://www.tiktok.com/@___siwo___"
            target="_blank"
            rel="noopener noreferrer"
            className="font-medium text-[#14b8a6] hover:text-[#0d9488]"
          >
            TikTok
          </a>
          .
        </p>

        <div className="mt-10">
          <a
            href="/"
            className="inline-flex items-center gap-2 rounded-[12px] border border-[#e2e8f0] bg-white px-6 py-3 font-inter text-[15px] font-semibold text-[#1d242f] shadow-sm transition hover:-translate-y-0.5 hover:border-[#14b8a6] hover:text-[#14b8a6]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al inicio
          </a>
        </div>
      </article>
    </main>
  </div>
</Layout>
